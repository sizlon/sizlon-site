---
// GitHub Pages는 dist/404.html 하나로 모든 경로의 404를 처리한다 — 한국어가 기본이고,
// 요청 경로가 /en 하위면 인라인 스크립트가 본문을 영어로 전환한다.
import Base from '../layouts/Base.astro';
import { content } from '../i18n/content';

const ko = content.ko.notFound;
const en = content.en.notFound;
---

<Base title={ko.title} description={ko.description} lang="ko" noindex>
  <section class="section wrap nf">
    <p class="code">404</p>
    <div data-nf="ko">
      <h1>{ko.h1}</h1>
      <p class="lede">{ko.body}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">{ko.home}</a>
        <a class="btn btn-ghost" href="/contact/">{ko.contact}</a>
      </div>
      <p class="alt">{ko.miriboaNote} <a href="https://miriboa.sizlon.io">miriboa.sizlon.io</a></p>
    </div>
    <div data-nf="en" hidden>
      <h1>{en.h1}</h1>
      <p class="lede">{en.body}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/en/">{en.home}</a>
        <a class="btn btn-ghost" href="/contact/">{en.contact}</a>
      </div>
      <p class="alt">{en.miriboaNote} <a href="https://miriboa.sizlon.io/en/">miriboa.sizlon.io/en</a></p>
    </div>
  </section>
</Base>

<script>
  if (location.pathname === '/en' || location.pathname.startsWith('/en/')) {
    document.documentElement.lang = 'en';
    document.querySelector('[data-nf="ko"]')?.setAttribute('hidden', '');
    document.querySelector('[data-nf="en"]')?.removeAttribute('hidden');
  }
</script>

<style>
  .nf { max-width: var(--measure); padding-block: 6rem; }
  [hidden] { display: none !important; }
  .code {
    font-family: var(--font-mono);
    font-size: var(--step-2);
    color: color-mix(in srgb, var(--color-ink) 45%, var(--color-vellum));
    margin: 0 0 0.5rem;
  }
  .lede { margin-top: 0.75rem; }
  .cta-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .alt { margin-top: 2rem; font-size: var(--step--1); color: var(--color-slate); }
</style>
