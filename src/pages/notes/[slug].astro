---
// 증거 글 라우트 — /notes/<slug>/ (2026-09-06). 본문은 src/content/notes/<slug>.md.
import { getCollection } from 'astro:content';
import Note from '../../sections/Note.astro';

export async function getStaticPaths() {
  const entries = await getCollection('notes');
  const ids = new Set(entries.map((e) => e.id));
  return entries.filter((e) => !e.id.startsWith('en/')).map((entry) => ({ params: { slug: entry.id }, props: { entry, twin: ids.has(`en/${entry.id}`) } }));
}
const { entry, twin } = Astro.props;
---
<Note entry={entry} twin={twin} />
