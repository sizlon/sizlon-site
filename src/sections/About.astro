---
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n/content';
import { t, localizePath } from '../i18n/utils';
// 회사 소개 — 제품 페이지가 아니라 회사 자체를 설명하는 유일한 페이지.
// 제품 서사는 각 제품 페이지가, 미리보아 창업자 서사는 서비스 사이트가 담당하고,
// 여기서는 법인·원칙·연락처 등 실사에서 확인되는 것을 정본으로 둔다.

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const c = tr.about;
---

<Base title={c.title} description={c.description} lang={lang}>
  <section class="hero band-ink section">
    <div class="wrap head">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </section>

  <section class="section wrap body">
    {c.sections.map((s) => (
      <div class="block">
        <h2>{s.h}</h2>
        {s.p.map((para) => <p>{para}</p>)}
      </div>
    ))}
  </section>

  <section class="section wrap">
    <h2 class="facts-h">{c.factsTitle}</h2>
    <dl class="facts">
      {c.facts.map((f) => (
        <div class="row">
          <dt>{f.k}</dt>
          <dd>{f.v}</dd>
        </div>
      ))}
    </dl>
    <a class="btn btn-primary cta" href={localizePath('/contact', lang)}>{c.cta} <span class="arrow">&rarr;</span></a>
  </section>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); }
  .body { display: flex; flex-direction: column; gap: 2.5rem; max-width: var(--measure); }
  .block { display: flex; flex-direction: column; gap: 0.75rem; }
  .block h2 { font-size: var(--step-1); }
  .block p { color: var(--color-slate); line-height: 1.7; margin: 0; }
  .facts-h { font-size: var(--step-1); margin-bottom: 1.25rem; }
  .facts {
    margin: 0;
    border-top: 1px solid var(--hairline);
    max-width: var(--measure);
  }
  .row {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  dt { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-slate); }
  dd { margin: 0; font-size: var(--step-0); }
  .cta { margin-top: 2rem; }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
