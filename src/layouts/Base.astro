---
// Self-hosted variable fonts (no third-party runtime calls). Family names used in global.css.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
// Korean (Hangul) coverage — Latin display/body fonts are Latin-only, so
// Pretendard is the per-glyph Hangul fallback in the font stacks.
import '@fontsource/pretendard/400.css';
import '@fontsource/pretendard/500.css';
import '@fontsource/pretendard/600.css';
import '@fontsource/pretendard/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import type { Lang } from '../i18n/content';
import { t, logicalPath } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** 색인 제외 — 404 등. sitemap 제외(astro.config.mjs filter)와 쌍. */
  noindex?: boolean;
  /** 제목을 그대로 쓴다(홈처럼 이미 브랜드가 들어간 제목). */
  rawTitle?: boolean;
}
const { title, description, lang = 'ko', noindex = false, rawTitle = false } = Astro.props;
const fullTitle = rawTitle ? title : `${title} — ${lang === 'en' ? 'Sizlon' : '시즐론'}`;
const tr = t(lang);
// hreflang 은 홈 한 쌍(/ ↔ /en/)에만. 다른 페이지는 한국어만 있다. x-default 는 ko.
const logical = logicalPath(Astro.url);
const isHome = logical === '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const homeKo = new URL('/', Astro.site);
const homeEn = new URL('/en/', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="naver-site-verification" content="d0586033fd852b5a82dfb099fa52528c9d74a792" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="시즐론 Sizlon" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="시즐론 — 검색 진단 · 감리 대응 · 데이터 피드" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.href} />
    {isHome && !noindex && <link rel="alternate" hreflang="ko" href={homeKo.href} />}
    {isHome && !noindex && <link rel="alternate" hreflang="en" href={homeEn.href} />}
    {isHome && !noindex && <link rel="alternate" hreflang="x-default" href={homeKo.href} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: '시즐론',
      alternateName: 'Sizlon Inc.',
      url: 'https://sizlon.io',
      logo: 'https://sizlon.io/logo/sizlon-logo.svg',
      description: '한국어 검색 품질 진단, 공공 SI 감리 대응 요구사항 추적표, 월정액 데이터 피드. 매체 7,000곳·일 20만 건 수집·색인 인프라를 구축·운영한 검색 엔지니어가 직접 수행합니다.',
      founder: { '@type': 'Person', name: '이광연', alternateName: 'Kwangyeon Lee' },
      // 2026-09-05 전화 규칙 철회(v3 §3.7): 검색 결과의 통화 버튼이 원하는 신호다.
      telephone: site.contactPhoneIntl,
      email: site.contactEmail,
      openingHours: 'Mo-Fr 09:00-18:00',
      areaServed: 'KR',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '원효로 189-7, 302호',
        addressLocality: '용산구',
        addressRegion: '서울특별시',
        addressCountry: 'KR',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: site.contactPhoneIntl,
        email: site.contactEmail,
        contactType: 'sales',
        availableLanguage: ['ko', 'en'],
      },
      subOrganization: { '@type': 'Organization', name: 'Miriboa', url: 'https://miriboa.sizlon.io' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">{tr.common.skip}</a>
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // 쿠키 없는 자체 방문 비콘 — 페이지 이탈 시점에 경로·언어·리퍼러·최대
      // 스크롤 깊이·체류시간만 svc.sizlon.io(/api/hit)로 보낸다. 식별자와
      // 쿠키는 없고, 서버도 IP를 저장하지 않는다(일일 salt 해시만). DNT 존중.
      // text/plain 문자열로 보내 CORS preflight 없는 단순 요청을 유지한다.
      const local = ['localhost', '127.0.0.1'].includes(location.hostname) || location.hostname.endsWith('.localhost');
      const dnt = navigator.doNotTrack === '1';
      let t0 = Date.now();
      let maxScroll = 0;
      let sent = false;
      const measure = () => {
        const total = document.documentElement.scrollHeight - innerHeight;
        const pct = total > 0 ? Math.round((scrollY / total) * 100) : 100;
        if (pct > maxScroll) maxScroll = Math.min(pct, 100);
      };
      const send = () => {
        if (sent || local || dnt) return;
        sent = true;
        navigator.sendBeacon(
          'https://svc.sizlon.io/api/hit',
          JSON.stringify({
            p: location.pathname,
            l: document.documentElement.lang,
            r: document.referrer,
            s: maxScroll,
            d: Date.now() - t0,
          }),
        );
      };
      addEventListener('scroll', measure, { passive: true });
      measure();
      addEventListener('pagehide', send);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') send();
      });
      // bfcache 복원(뒤로가기)은 새 방문으로 다시 계측한다.
      addEventListener('pageshow', (e) => {
        if (e.persisted) { sent = false; t0 = Date.now(); maxScroll = 0; measure(); }
      });
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-recovered);
        color: var(--color-ink);
        padding: 0.6rem 1rem;
        z-index: 20;
        border-radius: 0 0 var(--radius) 0;
      }
      .skip:focus { left: 0; }
    </style>
  </body>
</html>
