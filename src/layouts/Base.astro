---
// Self-hosted variable fonts (no third-party runtime calls — matches the
// product's offline ethos). Family names used in global.css.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
// Korean (Hangul) coverage — Latin display/body fonts are Latin-only, so
// Pretendard is the per-glyph Hangul fallback in the font stacks.
import '@fontsource/pretendard/400.css';
import '@fontsource/pretendard/500.css';
import '@fontsource/pretendard/600.css';
import '@fontsource/pretendard/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/content';
import { t, localizePath, logicalPath } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** 색인 제외 — 리디렉트 스텁 등. sitemap 제외(astro.config.mjs filter)와 쌍. */
  noindex?: boolean;
}
const { title, description, lang = 'en', noindex = false } = Astro.props;
const fullTitle = title === 'Sizlon' ? title : `${title} — Sizlon`;
const tr = t(lang);
// en/ko 쌍의 hreflang — 언어 스위처와 같은 logicalPath/localizePath 로직.
// x-default는 en(기본 로케일). noindex 페이지는 hreflang 클러스터에서 제외.
const logical = logicalPath(Astro.url);
const altEn = new URL(localizePath(logical, 'en'), Astro.site);
const altKo = new URL(localizePath(logical, 'ko'), Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* First-visit language: redirect between the en (root) and ko (/ko) versions
         to match the browser's preferred language. A manual EN/KO choice is
         remembered in localStorage and disables this. Runs before paint so there
         is no flash of the wrong language. */
      (function () {
        try {
          /* 검색엔진 렌더러(WRS 등)는 localStorage가 비고 언어가 en-US라 모든
             ko 페이지가 en으로 리디렉트돼 보인다 — 봇은 자동 리디렉트에서 제외
             (언어 매칭은 hreflang이 담당). */
          if (/bot|crawler|spider|crawling|yeti|slurp|bingpreview|headless/i.test(navigator.userAgent)) return;
          if (localStorage.getItem('lang')) return; // user chose explicitly — respect it
          var path = location.pathname;
          var onKo = path === '/ko' || path.indexOf('/ko/') === 0;
          var langs = navigator.languages && navigator.languages.length
            ? navigator.languages : [navigator.language || 'en'];
          var prefersKo = false;
          for (var i = 0; i < langs.length; i++) {
            var l = (langs[i] || '').toLowerCase();
            if (l.indexOf('ko') === 0) { prefersKo = true; break; }
            if (l.indexOf('en') === 0) { break; }
          }
          var cur = onKo ? 'ko' : 'en';
          var pref = prefersKo ? 'ko' : 'en';
          if (pref === cur) return;
          var target = pref === 'ko'
            ? (path === '/' ? '/ko/' : '/ko' + path)
            : (path.replace(/^\/ko(?=\/|$)/, '') || '/');
          if (target !== path) location.replace(target + location.search + location.hash);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="naver-site-verification" content="d0586033fd852b5a82dfb099fa52528c9d74a792" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sizlon" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sizlon — AI proposes. A deterministic layer verifies." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.href} />
    {!noindex && <link rel="alternate" hreflang="en" href={altEn.href} />}
    {!noindex && <link rel="alternate" hreflang="ko" href={altKo.href} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={altEn.href} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Sizlon Inc.',
      alternateName: '주식회사 시즐론',
      url: 'https://sizlon.io',
      logo: 'https://sizlon.io/logo/sizlon-logo.svg',
      description: 'Sizlon builds systems for work that can’t be wrong — an AI layer proposes, a deterministic layer verifies, and only what holds is promoted.',
      founder: { '@type': 'Person', name: 'Kwangyeon Lee' },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '302, 189-7 Wonhyo-ro, Yongsan-gu',
        addressLocality: 'Seoul',
        addressCountry: 'KR',
      },
      // 전화 응대를 하지 않으므로 telephone은 넣지 않는다 — 구조화 데이터의
      // telephone은 검색 결과에 통화 버튼을 띄우는 신호다. 문의는 이메일.
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'hello@sizlon.io',
        contactType: 'sales',
        availableLanguage: ['ko', 'en'],
      },
      subOrganization: { '@type': 'Organization', name: 'Miriboa', url: 'https://miriboa.sizlon.io' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">{tr.common.skip}</a>
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // 쿠키 없는 자체 방문 비콘 — 페이지 이탈 시점에 경로·언어·리퍼러·최대
      // 스크롤 깊이·체류시간만 svc.sizlon.io(/api/hit)로 보낸다. 식별자와
      // 쿠키는 없고, 서버도 IP를 저장하지 않는다(일일 salt 해시만). DNT 존중.
      // text/plain 문자열로 보내 CORS preflight 없는 단순 요청을 유지한다.
      const local = ['localhost', '127.0.0.1'].includes(location.hostname);
      const dnt = navigator.doNotTrack === '1';
      let t0 = Date.now();
      let maxScroll = 0;
      let sent = false;
      const measure = () => {
        const total = document.documentElement.scrollHeight - innerHeight;
        const pct = total > 0 ? Math.round((scrollY / total) * 100) : 100;
        if (pct > maxScroll) maxScroll = Math.min(pct, 100);
      };
      const send = () => {
        if (sent || local || dnt) return;
        sent = true;
        navigator.sendBeacon(
          'https://svc.sizlon.io/api/hit',
          JSON.stringify({
            p: location.pathname,
            l: document.documentElement.lang,
            r: document.referrer,
            s: maxScroll,
            d: Date.now() - t0,
          }),
        );
      };
      addEventListener('scroll', measure, { passive: true });
      measure();
      addEventListener('pagehide', send);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') send();
      });
      // bfcache 복원(뒤로가기)은 새 방문으로 다시 계측한다.
      addEventListener('pageshow', (e) => {
        if (e.persisted) { sent = false; t0 = Date.now(); maxScroll = 0; measure(); }
      });
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-recovered);
        color: var(--color-ink);
        padding: 0.6rem 1rem;
        z-index: 20;
        border-radius: 0 0 var(--radius) 0;
      }
      .skip:focus { left: 0; }
    </style>
  </body>
</html>
